# Copy to .env (never commit .env). Everything below is OPTIONAL: the app works with none of it.

# Explanation provider. "rule" = fully local, rule-based (default, no network).
#   "anthropic" / "openai" send ANONYMISED transcript excerpts + numeric features only (never audio/video/frames).
#   Using any external provider requires organiser approval when real recordings are involved.
EXPLAINER_PROVIDER=rule

# Only needed if EXPLAINER_PROVIDER is not "rule"
LLM_API_KEY=
LLM_MODEL=

# Local transcription (only used when no VTT is supplied): tiny | base | small
WHISPER_MODEL=base

# Safety caps for the hosted app
MAX_VIDEO_MINUTES=90
MAX_PROCESSING_SECONDS=600
